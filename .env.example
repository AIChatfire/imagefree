# ============================================================================
# imagefree-service 环境变量模板
#
#   cp .env.example .env
#
# 🔴 与 ../hailuo 最大的差别：**上游没有凭据**（imagefree.net 免登录）。
#    所以本文件里没有"必须填"的项 —— 空着就能跑。
#
# 每条都写了「为什么是这个默认值」。拿不出依据的旋钮**不存在** ——
# 所以本文件里的每一项都能在 app/ 或 gunicorn_conf.py 里找到**唯一**的读取点
# （`tests/test_wiring.py::test_every_knob_is_read_somewhere` 会逐条断言）。
# ============================================================================

# ---------------------------------------------------------------- 上游
# 上游基址。自建/灰度环境才需要改。
IMAGEFREE_BASE_URL=https://imagefree.net

# 上游的**浏览器身份** cookie（`imagefree_free_generation_id`）。
# 留空是常态：提交时上游若下发，本进程会用 cookie jar 自动持有并复用。
# 填上的用处只有一个：多个副本/多台机器**共用同一个浏览器身份**，
# 好把上游那层"同浏览器只允许一个在途任务"的记账集中到一处。
# ⚠️ 上游持有它 = 知道"你是谁"，别贴进公开渠道。
IMAGEFREE_FREE_GENERATION_ID=

# Turnstile token。上游当前把这个开关**硬编码成关闭**（docs/UPSTREAM.md §5），
# 所以默认留空 ⇒ 提交时按抓包发 `null`。
# 🔴 **开关一旦被打开**（工具端点已经打开了），提交会被人机校验挡住，此时必须能提供 token；
#    拿不到则任务终态 failure（code=upstream_turnstile_required，503 语义，**部署问题**）。
# ⚠️ 静态值的**有效期只有几分钟** ⇒ 只适合"临时验证"；生产（尤其无头 Linux）用下面的按需铸造。
IMAGEFREE_TURNSTILE_TOKEN=

# **按需铸 token**（无头 Linux 部署的推荐形态）：工具端点每次提交前**现铸现用**。
#   例：IMAGEFREE_TURNSTILE_MINT_CMD=node scripts/mint_turnstile.cjs --headless --json
# ⚠️ 三件必须一起满足，否则无头环境铸不出来（详见 docs/DEPLOY.md §3）：
#    ① 铸造环境设 **TZ**，且与出口 IP 地理**一致**（如 Asia/Shanghai）——
#       缺 TZ ⇒ Chrome 跑 UTC ⇒ CF 判「时区与 IP 不一致」⇒ 挑战升级为交互式（要人点）⇒ 无头必失败；
#    ② 有 node + playwright-core + 一个真 Chrome/Chromium；
#    ③ token **现铸现用**，别缓存（铸一次实测 3~15s）。
IMAGEFREE_TURNSTILE_MINT_CMD=

# 单次铸造超时（秒）。无头环境含浏览器启动，60s 是宽松但安全的预算。
IMAGEFREE_TURNSTILE_MINT_TIMEOUT=60

# 单次上游请求的超时（秒）。上游是 Cloudflare 边缘，首字节慢但稳定；
# 查询实测亚秒级，30s 足够覆盖提交与查询。
UPSTREAM_TIMEOUT=30

# **单个出口 IP 上允许同时在跑的任务数** —— 上游实测 **3**（第 4 个并发会 429）。
#   有效容量 = min(IF_CONCURRENCY, 出口数 × 本值)
# ⇒ 加出口是真的能扩容量：N 个出口最多 N×3 个在途任务。
# ⚠️ 不是“每天几张”的配额，也不是“一个 IP 只能一个任务”：实测
#    5 条并发 → 3 受理 + 2 个 429 FREE_TASK_IP_ACTIVE；在途任务一结束名额即恢复。
IMAGEFREE_IP_CONCURRENCY=3

# ---------------------------------------------------------------- 出口（可选：加代理绕频控）
# 出口清单，逗号分隔。**留空 = 直连**（与加代理之前的行为逐字一致）。
#   IMAGEFREE_PROXIES=http://127.0.0.1:7890
#   IMAGEFREE_PROXIES=cn=http://user:pass@10.0.0.1:8080,us=socks5://10.0.0.2:1080
#
# 🔴 为什么"只换 IP"不够：上游限流是**两层** —— IP 维度（FREE_TASK_IP_ACTIVE）
#    与**浏览器身份**维度（FREE_GENERATION_ACTIVE / FREE_TASK_BROWSER_ACTIVE）。
#    本服务给**每个出口**建一个独立的 HTTP 客户端 ⇒ 独立 cookie jar
#    ⇒ 上游给每个出口单独下发一个浏览器身份。两层墙因此同时被绕过。
#
# ⚠️ 因此配了多个出口时**不要**再固定 IMAGEFREE_FREE_GENERATION_ID
#    （那会让所有出口共用一个浏览器身份，浏览器那层的墙照样挡你，启动会打 WARNING）。
#
# ⚠️ 出口数决定**有效容量**：有效容量 = min(IF_CONCURRENCY, 出口数)，
#    且一个出口同时只跑一个任务（上游规则）。想并行 N 个就配 N 个出口
#    并把 IF_CONCURRENCY 提到 N —— 启动日志会说明实际生效的容量。
#
# ⚠️ 出口写错（scheme 不支持 / 标签重复 / 同一个代理写两遍）会让**服务启动失败**：
#    静默忽略等于"看着配了却什么都没发生"。
IMAGEFREE_PROXIES=

# 是否仍把**直连**当作一个出口、并排在**最前面**。
#   1 = 直连优先，池子只兜底（直连的名额满了，溢出的任务才走代理池）；
#   0 = **全部走池子** —— **默认**（直连完全不出现，连查询也不走直连）。
# 🔴 默认走池子的理由：上游按 **IP** 记账 ⇒ 直连烧的是**本机出口 IP 的额度**；
#    轮换型池子每连接换一个 IP ⇒ 等价于扩容量且不动本机名额。
# 想用直连就显式写 1。⚠️ `IMAGEFREE_PROXIES` 留空时本项无意义（仍只有直连一个出口）。
IMAGEFREE_USE_DIRECT=0

# 🔴 **池子扇出**：把每一个代理出口复制成 N 个（各自独立客户端 ⇒ 独立 cookie jar）。
# 这是**扩容量**：上游按 IP 记在途名额（单 IP 上限 3）⇒ N 个出口最多 3N 个在途任务。
#   1 = 不展开 —— **默认**（与加这个参数之前逐字一致）。
# ⚠️ 只对**代理**出口生效，直连不参与（它只有一个 IP，复制=同一名额重复计数）。
# ⚠️ 值得扇出的是**轮换型池子**（每 TCP 连接换一个出口 IP）；固定出口代理展开只会
#    把同一个 IP 重复计数，还不如不展开。上限 16。
IMAGEFREE_POOL_FANOUT=1

# 某个出口撞到"同 IP/同浏览器已有在途任务"后冷置它多少秒，好让后来的任务优先换出口。
# 只有一个出口时这项不生效（换无可换，仍走退避）。0 = 不冷置。
IMAGEFREE_PROXY_COOLDOWN=60

# 撞墙后在**同一个出口**上当场重试几次（每次都是新连接）。
# 🔴 轮换型代理（典型写法 http://…:2088 / socks5h://…，**每 TCP 连接换一个出口 IP**）
#    的下一连接很可能就是新 IP ⇒ 当场重试远比等退避划算；且被拒=上游没创建任务，
#    **不消耗额度**。直连出口的 IP 不变，代码里对直连出口跳过这项。
# 用轮换池时建议设 3~5；用的是固定出口代理时设 0（重试只会白撞）。
IMAGEFREE_PROXY_RETRIES=3

# ---------------------------------------------------------------- 对外鉴权
# 逗号分隔的静态白名单。**留空 = 鉴权整体关闭**（仅限内网/联调，启动会打 WARNING）。
# 🔴 生产**必须**设：不设的话，任何能访问本端口的人都能消耗你的免费额度
#    （而且上游是按 IP 记账的 —— 别人打爆的是**你这台机器**的额度）。
API_KEYS=

# ---------------------------------------------------------------- 节奏闸门
# 同时在上游跑的任务数。**默认 1 是刻意的策略选择，不是保守参数**：
# 上游限流维度是"在途互斥"（同浏览器/同 IP 只允许一个任务在跑），
# 并发 > 1 的第二个请求必然被拒 ⇒ 只会抬高失败率，不会提高吞吐。
IF_CONCURRENCY=1
# 相邻两次**提交**之间的最小间隔（秒）。0 = 不限。
# ⚠️ 账本是**进程内**的 ⇒ 副本数 N 等于把它放宽 N 倍（见 gunicorn_conf.py）。
IF_MIN_INTERVAL=0
# 每分钟最多提交几个任务。0 = 不限。
IF_PER_MINUTE=0

# ---------------------------------------------------------------- 轮询
# 提交之后、第一次查询之前的等待（秒）。**早问一次是零代价的**
# （未落库只是"还没好"），晚问才是代价 ⇒ 取小值。
POLL_GRACE=0.5
# 两次查询之间的间隔（秒）。上游出图实测 20~60s
# （前端自己用 6/4/10/15/20 然后 30 的退避序列，见 docs/UPSTREAM.md §3.1）：
# 固定 5s 对账简单，且查询是**零额度**的只读动作。
POLL_INTERVAL=5
# 单个任务的最长等待秒数。超时 → 任务终态 failure（code=task_timeout）。
# 默认 780 略大于前端自己的预算（≈775s）。
# ⚠️ 超时后上游任务**是否仍在跑并占用额度**未取证 ⇒ 别断言它停了。
TASK_TIMEOUT=780

# ---------------------------------------------------------------- 图生图（image-i2i，2026-09-21 接入）

# 编辑器（/api/ai-photo-editor）实测会**长期 pending**（>10 分钟，docs/UPSTREAM.md §10.4）

# ⇒ 图生图有独立的超时预算，生成链路的 780s 对它不适用。

TASK_TIMEOUT_I2I=3600

# 参考图大小上限（MB）。上游上传限额实测 10MB。

I2I_UPLOAD_LIMIT_MB=10

# 代取调用方参考图的超时（秒）。调用方给的地址≠上游，超时收紧。

I2I_FETCH_TIMEOUT=30

# ---------------------------------------------------------------- 协调器
# ⚠️ 提交会消耗上游免费额度。**冒烟/自检时务必设 0**，否则它会代替你向上游提交。
COORDINATOR_ENABLED=1
COORDINATOR_TICK=1.0
# 任务租约时长（秒）。多副本时靠它选主；必须 >= 2×POLL_INTERVAL，
# 否则每轮都换主 = 等于没有租约。单副本时它承担的是"崩了能自愈"。
COORDINATOR_LEASE=30.0

# 优雅关闭时等协调器收尾的预算（秒）。**略小于** gunicorn 的 graceful_timeout（30s）。
# 停止信号会**拦在提交动作之前**（不再发起新的上游请求）⇒ 这里通常只等"一个在飞的 HTTP 请求"。
# 等超了只能强杀；那一刻若正好有提交在飞，重启后该任务会被判 `submit_unknown`（不会静默双建）。
COORDINATOR_STOP_GRACE=25.0

# ---------------------------------------------------------------- 持久化
# 任务库是**事实源**（受理不碰上游 ⇒ 任务必须先落地）。
# 生产用 PostgreSQL；SQLite 仅供本地试跑。
TASK_DB=sqlite+pysqlite:///./imagefree.db
# TASK_DB=postgresql+psycopg2://imagefree:<密码>@127.0.0.1:5432/imagefree
# 终态任务保留天数。过期由协调器清理（每小时最多清一次）。
TASK_RETENTION_DAYS=7

# ---------------------------------------------------------------- 可观测性
# 留空 = 只在本地留日志、不上报（启动时会说明原因）。
LOGFIRE_TOKEN=
OTEL_SERVICE_NAME=imagefree-service
LOGFIRE_ENVIRONMENT=
# 1 = 把上游原始报文绑成 span 属性。观测面**刻意不脱敏**：事后脱敏会改掉
# 上游的实际字段名，让人对着面板排查一个不存在的字段。
OTEL_CAPTURE_UPSTREAM=1
# 脱敏开关。**默认 0**。打开只影响 SDK 自带 scrubber，而它按值子串命中
# `token`/`credential` ⇒ 会把产物 URL 整条打成 [Scrubbed]。
OTEL_SCRUBBING=0

# ---------------------------------------------------------------- 服务
HOST=0.0.0.0
# 端口 8400：jimeng 是 8200、hailuo 是 8300，刻意错开以免本机同时跑多个时冲突。
PORT=8400
LOG_LEVEL=INFO
